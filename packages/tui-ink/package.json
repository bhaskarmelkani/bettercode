{
  "name": "bettercode",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.tsx",
  "bin": {
    "bettercode": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.tsx"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/cli.ts --outdir dist --target bun --sourcemap external && chmod +x dist/cli.js",
    "snapshots": "bun run script/snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:watch": "bun test --watch test/"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@opencode-ai/sdk": "workspace:*",
    "marked": "catalog:",
    "ink": "^5.0.0",
    "react": "^18.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
